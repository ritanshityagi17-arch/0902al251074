
#include <stdio.h>

int main()
{
    int n, i;
    int total = 0, sum = 0;

    printf("Enter n: ");
    scanf("%d", &n);

    int a[n-1];

    printf("Enter the numbers:\n");

    for(i = 0; i < n-1; i++)
    {
        scanf("%d", &a[i]);
        sum = sum + a[i];
    }

    total = n * (n + 1) / 2;

    printf("Missing number = %d", total - sum);

    return 0;
}
